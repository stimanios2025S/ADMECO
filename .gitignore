# dependencies
node_modules/

# next.js
.next/
out/
build/

# env secrets — NEVER commit real keys
.env
.env.local
.env*.local

# misc
.DS_Store
*.log
.vercel
.env*

# artefacts de build (regénérés à chaque `tsc`/`next build`)
tsconfig.tsbuildinfo
*.tsbuildinfo

# token du tunnel ADMEDCO — le vrai vit dans /etc/cloudflared/admedco.env
# (le modèle *.example peut, lui, rester dans le dépôt)
deploy/*.env
!deploy/*.env.example
*.token

# modules purs compilés hors application, pour scripts/verifier-chaine.mjs
.tmp-sim/

# feuille de remise des comptes d'atelier — contient des mots de passe
# en clair (scripts/creer-comptes-ateliers.mjs). Elle se régénère, elle
# ne se versionne pas.
comptes-ateliers.csv
