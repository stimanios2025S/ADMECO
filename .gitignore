# dependencies
node_modules/

# next.js
.next/
out/
build/

# env secrets — NEVER commit real keys
.env
.env.local
.env*.local

# misc
.DS_Store
*.log
.vercel
.env*

# artefacts de build (regénérés à chaque `tsc`/`next build`)
tsconfig.tsbuildinfo
*.tsbuildinfo

# token du tunnel ADMEDCO — le vrai vit dans /etc/cloudflared/admedco.env
