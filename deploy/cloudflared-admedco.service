# ═══════════════════════════════════════════════════════════
# SERVICE SYSTEMD — TUNNEL CLOUDFLARE ADMEDCO
#
# À installer dans /etc/systemd/system/cloudflared-admedco.service
#
# ⛔ NE JAMAIS lancer `cloudflared service install` sur ce serveur.
#    Cette commande écrit /etc/systemd/system/cloudflared.service —
#    c'est-à-dire le fichier du tunnel qui fait tourner
#    wa-gateway:3000 et rmasc-onsite:4002. Elle l'écraserait et
#    couperait les deux applications d'un coup. C'est précisément
#    pourquoi ce fichier-ci porte un nom distinct.
#
# ── Pourquoi il n'y a ni config.yml ni credentials ici ──
#
# Ce tunnel a été créé depuis le dashboard Cloudflare : il est
# « remotely-managed ». Ses règles d'ingress (les Public Hostnames)
# sont stockées chez Cloudflare, pas dans un fichier sur le serveur.
# Il n'a donc ni config.yml, ni fichier de credentials — seulement
# un token.
#
# C'est la différence avec le tunnel des deux autres applications
# (aef1e8a1-f335-4530-83bf-d4ba13c23785), qui lui est local :
#   /etc/cloudflared/config.yml + aef1e8a1-….json + cloudflared.service
#
# ── Le token est un SECRET ──
#
# Il vit dans /etc/cloudflared/admedco.env (root seul, chmod 600).
# Il ne doit jamais être committé, ni collé dans un fichier du dépôt.
#
# ⚠️ Vérifier le chemin du binaire avant d'installer :
#      command -v cloudflared
#    → /usr/local/bin/cloudflared (binaire téléchargé : le cas ici)
#    → /usr/bin/cloudflared     (paquet .deb/.rpm)
#    Si le chemin diffère, corriger la ligne ExecStart ci-dessous.
# ═══════════════════════════════════════════════════════════

[Unit]
Description=Cloudflare Tunnel — ADMEDCO (127.0.0.1:4003)
Documentation=https://developers.cloudflare.com/cloudflare-one/connections/connect-networks/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# root : cloudflared lit son token dans un fichier en 0600. Il ne fait
# que sortir une connexion vers Cloudflare, il n'ouvre aucun port local.
User=root

# Fournit $TUNNEL_TOKEN à la ligne ExecStart ci-dessous.
# Si ce fichier est absent, le service refuse de démarrer (c'est voulu :
# mieux vaut une erreur nette qu'un tunnel à moitié configuré).
EnvironmentFile=/etc/cloudflared/admedco.env

# --no-autoupdate : la mise à jour se fait à la main, jamais pendant un
#   redémarrage de production. Sans ce drapeau, cloudflared peut se
#   remplacer lui-même et repartir en cours de service.
ExecStart=/usr/local/bin/cloudflared --no-autoupdate tunnel run --token ${TUNNEL_TOKEN}

Restart=always
RestartSec=5

# Journal dédié, pour ne pas noyer celui du tunnel principal :
#   journalctl -u cloudflared-admedco -f
SyslogIdentifier=cloudflared-admedco
StandardOutput=journal
StandardError=journal

# Durcissement — volontairement modéré. Un durcissement trop agressif
# (ProtectSystem=strict) casse l'écriture de l'état interne au premier
# redémarrage, et la panne est silencieuse.
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
